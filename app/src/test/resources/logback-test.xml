<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="false" debug="false">
	<include resource="org/springframework/boot/logging/logback/defaults.xml"/>

	<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
		<encoder>
			<pattern>[%t, %d, %-5p, %C:%L] - %.-100000m%n</pattern>
		</encoder>
	</appender>

	<logger name="org.apache.cxf.common.logging" level="WARN" additivity="false"/>

	<root level="WARN">
		<!--<appender-ref ref="CONSOLE"/>-->
	</root>

	<logger name="no.nav.regoppslag" level="WARN" additivity="false"/>

	<logger name="org.apache.cxf.interceptor" additivity="true"/>

</configuration>